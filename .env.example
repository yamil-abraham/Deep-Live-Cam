# ElevenLabs API Configuration
# Copy this file to .env and add your credentials

# Your ElevenLabs API key
# Get it from: https://elevenlabs.io/api
ELEVENLABS_API_KEY=your_api_key_here

# Your ElevenLabs Voice ID
# Find available voices at: https://api.elevenlabs.io/v1/voices
# Default is Rachel (21m00Tcm4TlvDq8ikWAM)
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM